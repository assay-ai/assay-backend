{
  "name": "assay-backend",
  "version": "1.0.0",
  "description": "GoAssay.AI backend: NestJS API, MCP server, facilitator, scheduler and workers for verified x402 payments on Solana and EVM chains",
  "author": "",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24.0.0",
    "yarn": ">=1.22.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn client:build && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:docker:dev": "docker-compose up -d",
    "start:debug": "nest start --debug --watch",
    "start:prod": "yarn migration:run:prod && node dist/main",
    "start:api": "SERVICE_TYPE=api nest start",
    "start:api:dev": "SERVICE_TYPE=api nest start --watch",
    "start:api:prod": "SERVICE_TYPE=api node dist/main",
    "start:websocket": "SERVICE_TYPE=websocket nest start",
    "start:websocket:dev": "SERVICE_TYPE=websocket nest start --watch",
    "start:websocket:prod": "SERVICE_TYPE=websocket node dist/main",
    "start:scheduler": "SERVICE_TYPE=scheduler nest start",
    "start:scheduler:dev": "SERVICE_TYPE=scheduler nest start --watch",
    "start:scheduler:prod": "SERVICE_TYPE=scheduler node dist/main",
    "start:mcp": "SERVICE_TYPE=mcp nest start",
    "start:mcp:dev": "SERVICE_TYPE=mcp nest start --watch",
    "start:mcp:prod": "SERVICE_TYPE=mcp node dist/main",
    "start:worker": "SERVICE_TYPE=worker nest start",
    "start:worker:dev": "SERVICE_TYPE=worker nest start --watch",
    "start:worker:prod": "SERVICE_TYPE=worker node dist/main",
    "start:all": "SERVICE_TYPE=all nest start",
    "start:all:dev": "SERVICE_TYPE=all nest start --watch",
    "openapi:export": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/export-openapi.ts",
    "client:generate": "yarn workspace @assay/settlement-client run generate",
    "client:check": "yarn workspace @assay/settlement-client run check:generated",
    "mcp:ledger": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/mcp/ledger.ts",
    "mcp:session": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/mcp/session.ts",
    "mcp:policies": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/mcp/policies.ts",
    "demo:seed": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/demo/seed-provider-console.ts",
    "demo:toolsets": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/demo/seed-official-toolsets.ts",
    "demo:slash-case": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/demo/seed-slash-case.ts",
    "operator:add": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/operator/operators.ts add",
    "operator:list": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/operator/operators.ts list",
    "operator:remove": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/operator/operators.ts remove",
    "devnet:acceptance-fixture": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/devnet/acceptance-fixture.ts",
    "devnet:escrow-rail-b": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/devnet/escrow-rail-b.ts",
    "devnet:acceptance": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/devnet/acceptance-suite.ts",
    "testnet:acceptance": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/testnet/acceptance-suite.ts",
    "testnet:e2": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/testnet/e2-voucher-redemption.ts",
    "testnet:e2-mcp": "ts-node -r tsconfig-paths/register scripts/testnet/e2-mcp-rail-b.ts",
    "testnet:e5": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/testnet/e5-zero-eth-withdraw.ts",
    "testnet:e6": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/testnet/e6-reconcile.ts",
    "testnet:isolation": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/testnet/chain-isolation.ts",
    "devnet:deposit": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/devnet/deposit.ts",
    "devnet:init-config": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/devnet/initialize-config.ts",
    "devnet:import-key": "ts-node -r tsconfig-paths/register scripts/devnet/import-operator-key.ts",
    "devnet:stake-accounts": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/devnet/setup-stake-accounts.ts",
    "devnet:faucet": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/devnet/faucet.ts",
    "evidence:verify-chain": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/evidence/verify-chain.ts",
    "verifier:key:generate": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/verifier-key/generate.ts",
    "verifier:registry": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/verifier-key/registry.ts",
    "verifier:rotation-drill": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/verifier-key/rotation-drill.ts",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "yarn client:build && jest --config ./test/jest-unit.json",
    "test:watch": "jest --config ./test/jest-unit.json --watch",
    "test:cov": "jest --config ./test/jest-unit.json --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:unit": "yarn client:build && jest --config ./test/jest-unit.json",
    "test:unit:watch": "jest --config ./test/jest-unit.json --watch",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:integration:reset": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/test/reset-integration-databases.ts",
    "verify": "yarn lint && yarn build && yarn test && yarn test:integration",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "yarn build && node scripts/migration-generate.js",
    "migration:create": "yarn build && node scripts/migration-create.js",
    "migration:run": "yarn build && yarn typeorm migration:run -d dist/database/postgres/postgres.data-source.js",
    "migration:revert": "yarn build && yarn typeorm migration:revert -d dist/database/postgres/postgres.data-source.js",
    "migration:show": "yarn build && yarn typeorm migration:show -d dist/database/postgres/postgres.data-source.js",
    "migration:run:prod": "typeorm migration:run -d dist/database/postgres/postgres.data-source.js",
    "migration:revert:prod": "typeorm migration:revert -d dist/database/postgres/postgres.data-source.js",
    "migration:show:prod": "typeorm migration:show -d dist/database/postgres/postgres.data-source.js",
    "prepare": "[ \"$NODE_ENV\" = \"production\" ] && exit 0; husky ",
    "client:build": "yarn workspace @assay/settlement-client run build",
    "settlement:exercise": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/settlement/exercise-all.ts",
    "mcp:call": "node scripts/mcp/call-tool.mjs",
    "demo:broken-binding": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/mcp/seed/demo-broken-binding.ts",
    "demo:identity": "ts-node -r dotenv/config -r tsconfig-paths/register scripts/mcp/seed/demo-identity.ts"
  },
  "dependencies": {
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@bull-board/nestjs": "^7.1.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/cache-manager": "^2.2.2",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^11.1.9",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-socket.io": "^11.1.9",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/swagger": "^8.0.7",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^11.1.9",
    "@noble/curves": "1.9.7",
    "@socket.io/redis-adapter": "^8.3.0",
    "@solana-program/token": "^0.15.0",
    "@solana/kit": "^7.0.0",
    "@solana/web3.js": "^1.98.0",
    "@assay/settlement-client": "1.0.0",
    "bullmq": "^5.34.0",
    "cache-manager": "^5.7.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "express-basic-auth": "^1.2.1",
    "husky": "^9.1.7",
    "ioredis": "^5.8.2",
    "lint-staged": "^16.2.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tldts": "7.4.16",
    "typeorm": "^0.3.28",
    "viem": "2.21.55",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@modelcontextprotocol/client": "^2.3.1",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@solana-program/compute-budget": "^0.17.0",
    "@solana-program/memo": "^0.12.0",
    "@solana-program/system": "^0.13.0",
    "@sqds/multisig": "^2.1.4",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fast-check": "^4.9.0",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.7.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "maxWorkers": 4,
    "workerIdleMemoryLimit": "1GB"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
