# ===========================================
# GoAssay.AI backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ===========================================
# Application Configuration
# ===========================================
NODE_ENV=development
SERVICE_TYPE=all
# Options: api, websocket, scheduler, worker, all, api_and_scheduler, api_and_websocket, scheduler_and_worker

# Server Ports
API_PORT=3000
WEBSOCKET_PORT=3001
SCHEDULER_PORT=3002
WORKER_PORT=3003

# How many proxies (load balancers) sit in front of the API, for Express
# `trust proxy`. `request.ip`, which the operator sign-in throttle counts
# against, is wrong without it: behind a balancer every caller shares the
# balancer's address. 0 (default, local) ignores X-Forwarded-For. Production:
# exactly the number of hops in front of the API, e.g. 1 for one balancer.
# A higher value lets a caller pick their own address. Required when
# NODE_ENV=production (the API refuses to start without it; 0 is allowed).
# The public Explorer routes (/public/catalogue/*, /public/not-charged) rate
# limit per client address too, and are called from visitors' browsers (the
# frontend is a static export), so this must equal the REAL hop count — e.g.
# 2 for Cloudflare in front of a load balancer — or every visitor shares one
# limit (too low) or can choose their own address (too high).
# API_TRUST_PROXY_HOPS=0

# Browser origins allowed to call the API and WebSocket server with credentials,
# comma-separated exact origins (scheme://host[:port], no trailing slash).
# Only a listed origin is reflected in Access-Control-Allow-Origin; "*" is
# refused. Unset outside production: the local dashboards on :3000,
# :4000-:4005 and :4020 (localhost and 127.0.0.1). Required when NODE_ENV=production (the API refuses
# to start without it). The facilitator and MCP server allow any origin
# without credentials and ignore this.
# CORS_ALLOWED_ORIGINS=http://localhost:4000,http://localhost:4003

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=app
# Logs queries without their bound parameters (ParameterlessQueryLogger).
DATABASE_LOGGING=false
# Never set DEBUG=ioredis* in production: ioredis prints Redis commands with
# their arguments, unredacted (OAuth consent request ids among them).
# Integration tests: test/integration/bootstrap/di-wiring.integration.spec.ts builds
# the real app modules, so it needs DATABASE_USER, DATABASE_PASSWORD and DATABASE_NAME
# above plus ENABLED_CHAINS (Blockchain section) set in the environment it runs in.

# ===========================================
# Redis Configuration (used by BullMQ + cache + socket.io adapter)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ===========================================
# BullMQ Configuration
# ===========================================
# Namespace prefix for BullMQ keys in Redis. Override per-env when multiple
# environments share a single Redis instance (e.g. `app-staging`).
BULLMQ_PREFIX=app
# Default concurrency for worker processors that don't set their own.
WORKER_CONCURRENCY=4

# ===========================================
# Bull Board (queue dashboard)
# ===========================================
# Mounted on the API server at `${global-prefix}${BULLBOARD_PATH}` when enabled.
# Default URL: http://localhost:${API_PORT}/api/admin/queues
BULLBOARD_ENABLED=true
BULLBOARD_PATH=/admin/queues
BULLBOARD_USERNAME=admin
# REQUIRED when BULLBOARD_ENABLED=true. App fails to boot if empty — no
# default credential is shipped intentionally.
BULLBOARD_PASSWORD=change-me-locally

# ===========================================
# Diagnostics (error-contract probe)
# ===========================================
# Mounts GET /api/v1/diagnostics/errors/:domain, which raises a real error from
# one domain catalog so the single error shape can be checked against a running
# server. Unset means on outside production and off when NODE_ENV=production.
# Never on in production.
DIAGNOSTICS_ENABLED=true

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ===========================================
# Cache Configuration
# ===========================================
TYPEORM_CACHE_ENABLED=true
TYPEORM_CACHE_TTL_MULTIPLIER=1
# Server-side response cache (Redis); only routes with @HttpCacheTTL/@HttpCacheKey.
HTTP_CACHE_ENABLED=true
# Browser/CDN caching applies only to GETs that opt in with @CacheHeader. Every
# other GET is `private, no-cache` (ETag revalidation) and every write
# `no-store`, whatever these flags say. false = opted-in routes send no-store
# (browser) / CDN-Cache-Control: no-store (CDN) too.
BROWSER_CACHE_ENABLED=true
CDN_CACHE_ENABLED=true

# Per-caller rate limits on the dashboard API (reads 180/min, heavy reads
# 30/min per path, writes 20/min, money and chain intents per route; see
# src/shared/rate-limit/user-rate-limit.config.ts). Counted in Redis, falling
# back to a per-instance count when Redis is out. On unless set to false.
# API_USER_RATE_LIMITS_ENABLED=true

# Swagger at /api/docs. Unset: on, except NODE_ENV=production (off).
# `yarn openapi:export` writes the same document without a server.
# API_DOCS_ENABLED=false

# ===========================================
# Chains
# ===========================================
# The only chain endpoint the backend knows. Everything chain-specific lives
# behind src/modules/chains/ — see docs/architecture.md §"Module Structure Pattern".
SOLANA_RPC_URL=https://api.devnet.solana.com

# Which chains THIS deployment offers, as a comma-separated list of CAIP-2 ids.
#
# No default and no aliases. Unset, blank, or an entry that is not a CAIP-2 id
# fails the boot — a value that silently changes what is live must fail where
# somebody is looking. `mainnet` is not accepted because it is ambiguous once a
# second namespace exists.
#
#   solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp   Solana mainnet-beta
#   solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1   Solana devnet
#   eip155:4663                                Robinhood Chain mainnet
#   eip155:46630                               Robinhood Chain testnet
#
# The list narrows `ChainAdapterRegistry`, and that is where both directions are
# enforced, at BOOT: a chain here that no adapter serves refuses the boot naming
# it, and a chain an adapter serves but this list omits is not advertised, not
# reconciled and not resolvable — `resolve()` throws CHAIN_UNSUPPORTED and every
# call site inherits the refusal. Do NOT remove a chain that holds user
# balances — withdrawals on it become unreachable (see docs/runbooks/chains.md).
ENABLED_CHAINS=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
#
# To serve Robinhood Chain testnet as well, append it and set the four
# EVM sections below:
#   ENABLED_CHAINS=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1,eip155:46630
#
# `eip155:4663` (Robinhood MAINNET) **cannot be enabled**, and that refusal is a
# deliberate rather than a gap. The mainnet USDG address is UNRESOLVED —
# `cast code` at the testnet address on 4663 returns `0x` (see
# `docs/chain-facts.md` in the assay-evm repository) — so no settlement asset can honestly be registered for it
# and `chain-metadata.ts` has no row. `assertChainMetadata` refuses it at boot.
# Do not add a row by copying the testnet address: that turns a measured gap
# into a number the next reader trusts.

# ===========================================
# eip155 — Robinhood Chain
# ===========================================
# Everything in this section is REQUIRED when ENABLED_CHAINS names an eip155
# chain, and IGNORED when it does not. A Solana-only deployment leaves all of it
# blank and boots exactly as before.

# One HTTP RPC per eip155 chain, as a JSON object keyed by CAIP-2 chain id.
#
# HTTP only: every EVM RPC call goes through the egress client. There is no
# WebSocket transport to configure.
EVM_RPC_URLS=

# The RPC endpoints GET /chains hands to the BROWSER, same JSON shape, e.g.
# {"eip155:46630":"https://rpc.testnet.chain.robinhood.com"}. Separate from
# EVM_RPC_URLS on purpose: that one may be private. https only (http allowed
# for localhost). A chain missing here cannot be deposited to from the web app
# ("not available in this build").
PUBLIC_RPC_URLS=

# The three PROXY addresses and the settlement token, per chain.
#
# `config`, `stake` and `escrow` are the PROXY addresses: that is what an EIP-712
# `verifyingContract` names and what does not move across an upgrade. All seven
# fields are required and all seven are checked to be 20-byte 0x addresses at
# boot; an enabled eip155 chain missing an entry refuses the boot, because the
# alternative symptom is a 500 on a buyer's balance screen.
#
# `escrowImplementation`, `owner` and `admin` are what
# `VaultPort.assertVaultControl` compares the live chain against, and they are
# the ones that MOVE: `escrowImplementation` on every upgrade, `owner`
# (AssayConfig.owner(), the upgrade authority of all three contracts) on every
# ownership transfer, `admin` (AssayConfig.admin, the operational key the owner
# appoints; NOT the upgrade authority) on every appointment. Copy them from
# `deployments/<chainId>.json` in the assay-evm repository
# (`contracts.AssayEscrow.implementation`, `owner` and `admin`) — the same record
# its `script/verify-deployment.sh` reads. A change that does not update this
# variable stops the reconciler on its next pass, which is the correct
# behaviour for a change nobody recorded.
#
#   {"eip155:46630":{"config":"0x…","stake":"0x…","escrow":"0x…","asset":"0x…","escrowImplementation":"0x…","admin":"0x…","owner":"0x…"}}
EVM_DEPLOYMENTS=

# The settlement token on Robinhood Chain testnet (eip155:46630), usually the
# 6-decimal mock USD you deployed. No default: required whenever eip155:46630 is
# in ENABLED_CHAINS, and it must equal that chain's `asset` in EVM_DEPLOYMENTS.
ROBINHOOD_TESTNET_USDG_ADDRESS=

# The verifier signing key for eip155. secp256k1, and NEVER the Solana ed25519
# key — the two rotate independently on their own 180-day schedules, and the
# `curve` field is what makes swapping one for the other a refusal rather than a
# signature nobody can verify. Deleted from the process environment at first read.
#
#   [{"keyId":"verifier-evm-2026-09","chainId":"eip155:46630","secretKey":"0x…"}]
EVM_VERIFIER_SIGNING_KEYS=

# The relayer EOA, one key per chain. It sends the buyer-signed `*BySig`
# meta-transactions, the withdraw gas grant and the slash executor's calls. It
# has NO on-chain role and can NEVER move USDG, because every money-moving path
# in `AssayEscrow` is authorised by `msg.sender == buyer`, by a buyer's EIP-712
# signature, or by a registered verifier plus a timelock — and the relayer
# appears in none of them. A leak therefore costs exactly the ETH float in this
# key, a number the platform chooses. Target <= 0.05 ETH, topped up on a schedule.
#
# It must be a DIFFERENT key from EVM_REDEEMER_KEYS on every chain; the boot
# refuses a chain where the two are the same key.
#
# Deliberately NOT required when an eip155 chain is enabled: a read-only
# deployment serves balances and quotes with no relayer key at all, and demanding
# one would put a private key in every process that has no business holding one.
#
#   [{"chainId":"eip155:46630","secretKey":"0x…"}]
EVM_RELAYER_KEYS=

# The redeemer EOA, one key per chain: the address in `Config.params().redeemer`,
# the only sender `redeemVoucher` / `redeemVoucherBatch` accept. Same JSON shape
# and same handling as EVM_RELAYER_KEYS (read once, deleted from process.env, no
# value in any error), and NOT the same key: the boot refuses a chain where the
# redeemer and relayer keys are equal. It pays the gas of every redemption, so it
# has its own ETH float; the float monitor watches it against the same marks.
# Not required at boot — a process that never redeems holds none, and the first
# redemption fails loudly instead.
#
# With "redeem into hold" (G3.B1) this key ALSO moves held payments: it is the
# only sender of collectHeld[Batch] before the 7-day timeout (paying the
# provider) and of refundHeld[Batch] (returning a held payment to the buyer's
# escrow). Give it to the SCHEDULER only: the API never sends either — an
# upheld refund is left PENDING there and sent by the scheduler's refund job.
#
#   [{"chainId":"eip155:46630","secretKey":"0x…"}]
EVM_REDEEMER_KEYS=

# How little ETH is too little. Reported on every send, and the floor the zero-ETH
# gas grant below must leave intact — the relayer's float also pays for relayed
# buyer requests and slash sends, and a grant that empties it stops those. The
# monitor applies the same marks to the redeemer's float.
#
# BOTH are required once an eip155 chain is enabled, and CRITICAL must be
# strictly below LOW. The float monitor and the gas grant read the SAME symbol
# on purpose: two keys with one meaning drift silently, and in the worst
# direction.
# 0.01 ETH low, 0.002 ETH critical:
EVM_RELAYER_FLOAT_LOW_WEI=10000000000000000
EVM_RELAYER_FLOAT_CRITICAL_WEI=2000000000000000

# The zero-ETH withdraw grant. `AssayEscrow.withdraw()` is `msg.sender`-only
# and there is no `withdrawBySig` BY DESIGN, so a buyer who deposits USDG and
# holds no ETH has no exit at all; the relayer funds exactly the gas for one
# `withdraw`, ONCE PER ADDRESS EVER (a unique index, not a rate limit), under
# these two caps.
#
# NO DEFAULTS. An unset cap fails the boot when an eip155 chain is enabled — an
# unlimited faucet is not a safe fallback, and a cap that appears when the first
# buyer needs it is a cap nobody set. Both are refused if zero, negative,
# fractional or below one another.
# 0.002 ETH per grant, 0.05 ETH per rolling 24 hours:
EVM_RELAYER_GAS_GRANT_MAX_WEI=2000000000000000
EVM_RELAYER_GAS_GRANT_DAILY_MAX_WEI=50000000000000000

# The on-chain pause and blocklist cache (assay-evm D-19). The scheduler indexes
# AssayConfig's PauseToggled and BlockedSet into Postgres every minute and
# re-reads paused() / blocked() live every EVM_CHAIN_STATE_RECONCILE_MS; every
# process re-reads the tables every EVM_CHAIN_STATE_POLL_MS to refuse early what
# the chain would refuse. More than EVM_CHAIN_STATE_MAX_LAG_MS behind the head is
# a WARN in the log, an alert and `stale: true` on GET /operator/health. A cache:
# the contracts stay the enforcer. All optional; defaults shown.
EVM_CHAIN_STATE_POLL_MS=15000
EVM_CHAIN_STATE_RECONCILE_MS=300000
EVM_CHAIN_STATE_MAX_LAG_MS=300000
# Where a chain with no cursor starts indexing, e.g. {"eip155:46630":135100000}.
# Unset: 10,000 blocks behind the head (enough before the upgrade lands, since
# the blocklist has no earlier events and paused() is read directly). Set it to
# the upgrade's block when deploying after the upgrade.
EVM_CHAIN_STATE_FROM_BLOCK=

# ===========================================
# Public proof of reserves
# ===========================================
# The ONE asset `GET /api/v1/public/reserves` publishes, CAIP-19.
#
# Unset means the route is not registered and `/reserves` 404s — the page then
# says "not configured on this deployment". That is deliberate: a page with no
# asset would have to render empty tiles, and empty tiles read as zero
# reserves, which is a claim nobody made.
#
# One asset, not "every enabled asset". ENABLED_CHAINS may name several networks
# at once — and, once an EVM adapter exists, several namespaces — so an
# every-asset page would publish devnet vault figures beside mainnet ones under
# the heading "proof of reserves". The value is checked against ENABLED_CHAINS
# at BOOT and fails the deploy if it names a chain this deployment does not
# reconcile.
#
# It must be an asset the reconciler covers: the escrow contract's asset on an
# enabled eip155 chain (Solana has no vault), e.g.
#   eip155:46630/erc20:<ROBINHOOD_TESTNET_USDG_ADDRESS>
PUBLIC_RESERVES_ASSET=

# ===========================================
# Solana devnet
# ===========================================
# Devnet ONLY. Circle's devnet USDC faucet is captcha-gated, so the registered
# devnet mint (4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU) cannot be funded
# programmatically and the devnet end-to-end would have nothing to move. Set
# this to a mint you control to run scripts/devnet/deposit.ts.
#
# Mainnet is deliberately NOT overridable — the registry refuses this variable
# under NODE_ENV=production rather than quietly accepting a substitute for the
# asset the platform's custody is denominated in.
#
# kora/kora.toml allows only the default devnet USDC mint. A deployment that
# overrides this variable must add its mint to `allowed_tokens` there too.
SOLANA_DEVNET_USDC_MINT=

# ===========================================
# Facilitator — SERVICE_TYPE=facilitator
# ===========================================
# Its own process and its own port, so the fee-payer signer's credentials are
# never in the API's address space: a compromise of the API process does not
# yield the fee-payer key.
FACILITATOR_PORT=3100

# Where the API process's HttpFacilitatorAdapter (src/modules/chains/facilitator/)
# reaches this facilitator. Only read by the API process, not by the
# facilitator process itself.
FACILITATOR_URL=http://127.0.0.1:3100
FACILITATOR_TIMEOUT_MS=30000

# Which FeePayerSignerPort implementation the facilitator process resolves to.
# "kora" is the intended production path (see kora/README.md). "local" signs with a keypair loaded into this process and
# refuses to start when NODE_ENV=production — it exists so the facilitator is
# runnable and testable without a Kora node up.
FEE_PAYER_SIGNER=kora

# Required when FEE_PAYER_SIGNER=kora. The Kora RPC node's JSON-RPC 2.0
# endpoint — see kora/README.md to run one against devnet.
KORA_RPC_URL=http://127.0.0.1:8080
KORA_TIMEOUT_MS=30000

# Required when FEE_PAYER_SIGNER=local — EITHER this or LOCAL_FEE_PAYER_KEYPAIR
# below, and the inline form wins when both are set.
#
# Path to a solana-keygen-format keypair JSON file (a 64-byte array) — NEVER a
# production key. See
# src/modules/chains/facilitator/signing/local-keypair-fee-payer.signer.ts.
LOCAL_FEE_PAYER_KEYPAIR_PATH=

# The same material supplied INLINE, for a deployment that has no way to put a
# file on disk: an orchestrator can usually set variables more easily than it can
# mount files, and the path form costs a volume mount on every deployment that
# wants this signer.
# Every other key this platform holds already arrives as a variable; the fee
# payer was the last exception.
#
# Accepts what solana-keygen writes and what a person pastes:
#   [12,34,...]   64-byte keypair array, or a bare 32-byte seed
#   <hex>         the same bytes as hex, with or without 0x
#
# READ ONCE AT BOOT AND THEN DELETED FROM process.env — same four properties as
# VERIFIER_SIGNING_KEYS, and deleted even when the value fails to parse. No
# error quotes the value it could not read.
LOCAL_FEE_PAYER_KEYPAIR=

# ── MCP server ──────────────────────────────────────────────────────────────
# The service every agent calls. Its own process (SERVICE_TYPE=mcp) because the
# Streamable HTTP transport is stateless per request, so it scales on agent
# traffic alone.
MCP_PORT=3200

# The MCP host agents connect to, as a bare origin. Every path at its root is
# an MCP server — `/` the whole catalogue, `/my/{slug}` a toolset — so there is
# no `/mcp` prefix. The API builds toolset and Connect URLs from it too, so the
# API and the MCP service must agree. Defaults to http://localhost:3200 outside
# production and https://mcp.goassay.ai in production. The dev deployment sets
# it explicitly, e.g. MCP_PUBLIC_URL=https://mcp-dev.goassay.ai
# MCP_PUBLIC_URL=http://localhost:3200

# The web app a browser that opens an MCP URL is redirected to (a static
# export: every target is a query-string page). Required in production;
# defaults to http://localhost:4000 elsewhere.
# WEB_APP_URL=http://localhost:4000

# The root's "Always loaded" tools (root_pinned_tools): up to 5 tool names,
# comma separated, listed directly when `/` runs in search mode, before the
# agent's own pinned tools. Empty by default.
# MCP_ROOT_PINNED_TOOLS=get_weather,geocode_place

# The secret search_tools paging cursors are signed with (HMAC-SHA256), at
# least 32 characters and the same on every MCP instance. Required on every
# deployment that is not local (NODE_ENV=production, or an MCP_PUBLIC_URL that
# is not localhost); a local run uses a random per-process secret, so a cursor
# dies with the process. Generate one with: openssl rand -hex 32
# MCP_SEARCH_CURSOR_SECRET=

# Basis points of the quoted price the platform keeps. Configurable; the code
# default is 1000 (10%), matching the EVM escrow's takeRateBps. Also the take
# rate every screen prints (provider terms, operator economics, reconciliation):
# PLATFORM_FEE_BPS / 100.
PLATFORM_FEE_BPS=1000

# MCP tools/call idempotency (_meta["assay/idempotency-key"]): seconds a keyed
# call's result stays replayable in Redis for a retry, and the retry window.
# Default 900 (15 minutes), at most 3600; a larger value fails the boot.
# Arguments are never stored, only their hash. Outputs larger than
# MCP_IDEMPOTENCY_MAX_RESULT_BYTES (default 262144, 256 KB) are not stored:
# a replay then answers IDEMPOTENCY_RESULT_UNAVAILABLE with the intent id.
MCP_IDEMPOTENCY_TTL_SECONDS=900
MCP_IDEMPOTENCY_MAX_RESULT_BYTES=262144

# Files standing in for tables that do not exist yet. Each is empty when unset,
# and an unreadable or malformed file fails the boot rather than degrading into
# "nothing is configured".
#   catalogue  → tool_bindings / binding_versions
#   registry   → providers
#   credential → Privy-issued session tokens
# A working demo set lives in scripts/mcp/seed/. NOTE: the catalogue's assetId
# must be the asset this deployment actually holds — on devnet that is
# SOLANA_DEVNET_USDC_MINT — or every funded agent is told it has insufficient
# funds. loadToolCatalogue refuses an unregistered asset at boot for that reason.
TOOL_CATALOGUE_SEED_FILE=
PROVIDER_REGISTRY_SEED_FILE=
# MCP_CREDENTIALS_FILE is refused at boot when NODE_ENV=production. Outside
# development/local/test every token must be at least 32 characters, and a
# record is a person's session only with "kind": "human" (otherwise a machine).
MCP_CREDENTIALS_FILE=

# The catalogue, inline, for a deployment that cannot mount a file.
#
# A path needs something to put a file there, and on a container orchestrator
# that is a volume mount, which may be managed far from the person who needs to
# change the catalogue. The document is ~6 KB of JSON and fits comfortably in an
# environment variable, so this carries the same document as a value.
#
# Same parser, same boot-time validation, same failure modes. SET ONE OR THE
# OTHER: both set fails the boot, because a mounted file and a stale variable
# would disagree silently about what the router substitutes providers against.
TOOL_CATALOGUE_SEED_JSON=

# --- Provider stake source -------------------------------------------------
# The router's stake gate reads each provider's stake from the settlement
# program, through the enrolment's proved stake_authority.
#
# How long a chain reading is served without going back to the RPC. A load
# number: getting it wrong costs a round trip.
PROVIDER_STAKE_CACHE_TTL_MS=30000
#
# How long the last good reading is still served AFTER the RPC starts failing,
# before the provider drops to "no known stake" and the gate refuses. A
# correctness number, and the bound on how long a slashed or unbonded provider
# can keep taking paid traffic during an RPC outage. Raise it during an incident
# to trade freshness for availability; it is deliberately finite, because a
# degrade with no upper bound is just a cache that never expires.
PROVIDER_STAKE_STALE_MAX_MS=900000
#
# How long a signed challenge stays redeemable. Deliberately TWO knobs rather
# than one: a payout-side incident must not silently shorten the window on
# proving control of collateral, and vice versa.
PROVIDER_PAYOUT_CHALLENGE_TTL_SECONDS=600
PROVIDER_STAKE_AUTHORITY_CHALLENGE_TTL_SECONDS=600

# --- Observed provider stats -----------------------------------------------
# The router scores each binding on what it was observed doing: availability
# (attempts with no provider-caused SYSTEM_ERROR or timeout), the paid verdict
# PASS rate and the latency percentiles. The window is the last N attempts (and
# the last N verdicts) per binding, none older than 7 days, refreshed by the
# scheduler every five minutes. Below the minimum sample a figure stays
# unmeasured and the binding scores the neutral prior, as a new one does. Both
# are whole numbers; the boot refuses anything else, and a minimum above the
# window. Self-calls, client errors and our own faults are never counted.
BINDING_STATS_WINDOW_SIZE=1000
BINDING_STATS_MIN_SAMPLE=50
# Only PAID attempts count, and one buyer organization adds at most this many
# attempts (and verdicts) to a binding's window, so no single buyer can sink a
# competitor with voided failures or inflate an ally with cheap successes.
# 1 to BINDING_STATS_WINDOW_SIZE.
BINDING_STATS_MAX_PER_BUYER=20

# --- Verification kill switch ----------------------------------------------
# The kill switch is Redis-backed so a policy can be withdrawn WITHOUT a
# deploy. Every process keeps a local snapshot of the kill list; `isKilled` is
# a synchronous lookup on the settlement path of every verified call, so the
# switch is eventually consistent and these two numbers are its SLA.
#
# POLL_MS  is the bound: the pub/sub broadcast usually delivers in single-digit
#          milliseconds, and the poll is what makes the bound a guarantee
#          rather than a hope when a broadcast is lost.
# STALE_MS is the fail-safe: a process that cannot refresh for this long stops
#          trusting its own list and treats EVERY policy as withdrawn. That
#          turns a Redis outage into "verification is off and everything
#          settles", which is deliberate — enforcing a list we can no longer
#          confirm, during the incident where somebody is trying to pull a
#          policy, is the failure this whole mechanism exists to prevent.
VERIFICATION_KILL_SWITCH_NAMESPACE=verification:killswitch
VERIFICATION_KILL_SWITCH_POLL_MS=2000
VERIFICATION_KILL_SWITCH_STALE_MS=30000

# --- Account blocklist -----------------------------------------------------
# Blocks are rows in `account_blocks` (written by POST /operator/blocks), held
# in memory by every process. The writing process applies a change at once and
# announces it on CHANNEL; every other process re-reads on the message, and
# re-reads every POLL_MS regardless, so POLL_MS is the bound on how long another
# instance can keep serving a blocked account when a message is lost.
ACCOUNT_BLOCKLIST_CHANNEL=account-blocklist:changed
ACCOUNT_BLOCKLIST_POLL_MS=5000

# --- Verification sampling -------------------------------------------------
# The keyed secret `decideSampling` draws against — see
# the "Selection is keyed, not random" section of
# src/modules/verification/domain/sampling.ts. Unset means sampling is OFF, not insecure: the worker never draws,
# and every call's semantic stage records "not sampled" rather than drawing
# against a predictable well-known key. Safe to leave unset for now — no
# SemanticJudgePort implementation exists yet, so nothing spends money on a
# semantic judgement either way. Set this before wiring a real model client.
VERIFICATION_SAMPLING_SECRET=

# Overrides for the published budget constants
# (src/modules/verification/domain/sampling.ts — 20% of the platform fee,
# $0.0025 per judgement). Leave unset to use those figures.
VERIFICATION_SEMANTIC_RATIO_OF_FEE=
VERIFICATION_SEMANTIC_COST_USD=

# ===========================================
# Evidence pack retention
# ===========================================
# How long the RAW request and response behind an evidence pack are kept, in
# hours. 72 is a PUBLISHED figure, not a tuning knob: the dispute window is
# built on top of it. Lowering it takes evidence away from a provider who is still
# inside the window the product promised them; raising it keeps bodies the
# platform said it would not keep. Unset means 72.
#
# The pack itself is never deleted and stays verifiable forever — the hash
# covers the bodies' DIGESTS, not their bytes. Only the bodies go.
EVIDENCE_BODY_RETENTION_HOURS=

# Rows the hourly sweep removes per pass. Unset means 500. The sweep runs again
# in an hour, so a small batch is a throughput choice, never a correctness one.
EVIDENCE_SWEEP_BATCH_SIZE=

# ===========================================
# Verifier signing key
# ===========================================
# The key that signs slash attestations — one of the most valuable secrets in
# the system: whoever holds it can propose slashes against every provider
# (bounded on-chain by the allowlist, the 72h delay and the slash caps).
#
# THIS BACKEND CURRENTLY HOLDS IT IN AN ENVIRONMENT VARIABLE. The production
# target is a KMS — see docs/architecture.md §"Signing Keys" for the conditions
# and what has to happen before mainnet.
#
# Which custody backend to resolve.
#
#   env   implemented, and the current default
#   kms   implemented (AwsKmsSigner) — see VERIFIER_KMS_KEYS below for the three
#         things still needed to select it
#   turnkey | vault | privy   enum members with no class yet; selecting one
#         fails the boot with a list of what works, rather than resolving to
#         nothing and failing at the first signature
#
# Unset means `env` OUTSIDE production and a boot failure IN production — where
# the key lives must be a decision somebody made, not a default that was
# inherited.
VERIFIER_SIGNER_BACKEND=env

# Required when VERIFIER_SIGNER_BACKEND=env. A JSON array of
# { keyId, secretKey }, where secretKey is a 32-byte seed or a 64-byte
# seed+public key, as hex or as a solana-keygen byte array:
#
#   VERIFIER_SIGNING_KEYS=[{"keyId":"verifier-2026-08","secretKey":"<hex>"}]
#
# `yarn verifier:key:generate` emits the ready-made line.
#
# List EVERY key the deployment may need, not only the current one: rotation is
# only non-disruptive if the outgoing key is still loadable during the cutover,
# and which of them is ACTIVE is a row in `verifier_signing_keys`, not a value
# here. Adding a key is a restart; cutting over to one is not.
#
# READ ONCE AT BOOT AND THEN DELETED FROM process.env. After startup there is
# nothing here for a crash reporter, a diagnostics route or a child process to
# find — see src/modules/verification/signing/backends/env-key-source.ts.
VERIFIER_SIGNING_KEYS=

# The EVM verifier signing key(s) — secp256k1. A JSON array of
# { keyId, chainId, secretKey }:
#
#   EVM_VERIFIER_SIGNING_KEYS=[{"keyId":"verifier-evm-2026-09","chainId":"eip155:46630","secretKey":"0x<32-byte scalar, hex>"}]
#
# A SEPARATE variable from VERIFIER_SIGNING_KEYS, and it must never hold the
# same key. eip155 verifies secp256k1 and Solana verifies ed25519; the two key
# ids are `verifier-evm-<yyyy-mm>` and `verifier-solana-<yyyy-mm>`, and they
# rotate independently on their own 180-day schedules. One variable holding both
# curves would make "which key signs for which chain" a parsing question instead
# of a provisioning one.
#
# `chainId` is required per entry and is cross-checked against the directory row
# at every signature. Generating the key is a HUMAN action, and enrolling it is
# another one, under the admin Ledger (`AssayConfig.registerVerifier`) — nothing
# in this codebase enrols anything.
#
# Read once at boot and then deleted from process.env, exactly as the ed25519
# variable is, through the same function.
#
# Unlike the ed25519 backend, the material CANNOT be held non-extractably:
# WebCrypto has no secp256k1, so the scalar stays resident for the life of the
# process. That gap is closed by a KMS and by nothing at this layer.
EVM_VERIFIER_SIGNING_KEYS=

# The EVM relayer and redeemer EOAs' keys — the two accounts that PAY GAS. Each
# is a JSON array of { chainId, secretKey }:
#
#   EVM_RELAYER_KEYS=[{"chainId":"eip155:46630","secretKey":"0x<32-byte scalar, hex>"}]
#   EVM_REDEEMER_KEYS=[{"chainId":"eip155:46630","secretKey":"0x<a DIFFERENT scalar>"}]
#
# The REDEEMER is the address in Config.params().redeemer and sends only
# redeemVoucher / redeemVoucherBatch. The RELAYER has NO on-chain role: it sends
# buyer-signed *BySig requests, the withdraw gas grant and slash calls. They must
# be different keys on every chain — the boot refuses otherwise — so a leak of
# one is not a leak of both.
#
# Neither is a verifier key and neither must ever be one. They sign the
# platform's own transactions; they never sign anything a user relies on, and
# they cannot move USDG to themselves: every money-moving path in AssayEscrow is
# authorised by msg.sender == buyer, by a buyer's EIP-712 signature (a voucher
# the redeemer can only submit as signed), or by a registered verifier's
# attestation plus 72 hours.
#
# So a leak of either costs exactly the ETH float in that account, which is a
# number you choose. Target <= 0.05 ETH each, topped up on a schedule; each key
# warns once per incident when its balance falls below its low-water mark.
#
# Read once at boot and then deleted from process.env, through the same function
# the verifier keys go through. One entry per chain; two entries for one chain
# is a boot failure, because which of them sends would otherwise depend on map
# order.
EVM_RELAYER_KEYS=
EVM_REDEEMER_KEYS=

# Required when VERIFIER_SIGNER_BACKEND=kms. A JSON array of { keyId, arn }:
#
#   VERIFIER_KMS_KEYS=[{"keyId":"verifier-2026-08","arn":"arn:aws:kms:...:key/..."}]
#
# Note what this variable is NOT: a secret. An ARN names a key without granting
# anything — IAM decides who may call Sign on it — so unlike
# VERIFIER_SIGNING_KEYS it is safe to print, to commit to a deploy manifest and
# to leave in a crash report. That asymmetry is the entire point of moving.
#
# The KMS key must be ECC_NIST_EDWARDS25519. Solana verifies Ed25519, and AWS
# only gained EdDSA support in November 2025; an RSA or P-256 key would return a
# public key that can never verify anything, so the signer refuses it at the
# first lookup rather than letting it be enrolled on-chain.
#
# Selecting `kms` needs three things, and the boot error lists them:
#   1. yarn add @aws-sdk/client-kms
#   2. a KmsSigningClient adapter provided for KMS_SIGNING_CLIENT in
#      verifier-signing.module.ts (the client is deliberately unbound — the SDK
#      is not a dependency of a path nothing calls yet)
#   3. this variable
VERIFIER_KMS_KEYS=

# The deployed Anchor settlement program. Its verifier allowlist is what the
# signing path checks before it will use a key, so revoking a key on-chain is
# sufficient on its own to stop this platform signing with it. Unset means no
# program: nothing fails at boot, and the first signature fails loudly.
SOLANA_SETTLEMENT_PROGRAM_ID=

# --- Signing rate limit ----------------------------------------------------
# A verifier signature is one step from taking a provider's stake, and an
# unusual RATE is the earliest observable symptom of a stolen key. Attestations
# are issued per SLA window rather than per call, so real traffic is orders of
# magnitude under these; see domain/signing-rate-limit.ts for the derivation.
# Replace them with measurements once there is production traffic.
#
# Counted in Redis over a sliding window, and REFUSED when the counter is
# unavailable — the failure mode of signing anyway is that a stolen key keeps
# working through an outage an attacker can cause.
VERIFIER_SIGNING_RATE_WINDOW_SECONDS=60
VERIFIER_SIGNING_RATE_PER_KEY=60
VERIFIER_SIGNING_RATE_PER_REQUESTER=30
# Fraction of a ceiling at which an alert fires while still allowing the
# signature. A control that only speaks when it blocks reports the incident
# after it happened.
VERIFIER_SIGNING_RATE_WARN_RATIO=0.5

# How long an on-chain registry read is trusted. This is the bound on how long
# an on-chain revocation takes to stop this platform using the key.
VERIFIER_REGISTRY_CACHE_MS=15000
# How long before a key's on-chain expiry to start warning. An expiry is the
# one outage nobody is paged for, because it is an event that does not happen.
VERIFIER_KEY_EXPIRY_WARNING_MS=1209600000

# The three published terms documents. A provider must accept the
# versions currently published; accepting a version that does not exist is a
# 400 rather than a row nobody can interpret later.
PROVIDER_TERMS_AGREEMENT_VERSION=v1.0
PROVIDER_TERMS_PAYOUT_VERSION=v1.0
PROVIDER_TERMS_SLASH_POLICY_VERSION=v1.0

# The commercial-terms table the console prints during provider registration. Strings, because
# they are presentation content rather than numbers a client recomputes. All are
# configurable; the values below are the code defaults. The take rate is not
# here: it is PLATFORM_FEE_BPS above, so the printed rate is the charged one. The
# other exception is the stake floor, which is NOT here: it is read from
# PROVIDER_MINIMUM_STAKE_FLOOR so the onboarding screen and the router's stake
# gate cannot print two different numbers for the same bar.
PROVIDER_TERMS_RESERVE_HELD_USD=0.00
PROVIDER_TERMS_CLAWBACK=never
PROVIDER_TERMS_SLASH_TRIGGER="DATA_FAIL only"
PROVIDER_TERMS_PENALTY_SPLIT="60 / 30 / 10"

# ── Provider earnings ───────────────────────────────────────────────────────
# There are no variables here on purpose, and there is no earnings withdrawal
# either. `redeem_voucher` pays the provider's own associated token account in
# the same instruction that debits the buyer's escrow, so there is no pool to
# withdraw from.
#
# PROVIDER_PAYOUT_CHALLENGE_TTL_SECONDS (above) belongs to the payout-ADDRESS challenge/prove flow,
# and the address a provider proves there is the wallet the program pays.

# ── Escrow spend gate ───────────────────────────────────────────────────────
# `PaymentIntentService.secureFunds` prices a call against the buyer's
# on-chain escrow (`escrow_ata.amount` minus open holds) instead of the
# ledger mirror alone. The switch is OFF by design: turning it on has a
# precondition — every paying path must be rail B (a signed voucher), because
# an MCP rail-A call carries no signature and nothing can debit an escrow for it. Only
# the exact string `true` enables it; anything else fails closed.
ESCROW_SPEND_GATE_ENABLED=false

# --- Authentication: which issuer's tokens are accepted --------------------
# config  MCP_CREDENTIALS_FILE only — the demo tokens. The code default, kept
#         for tests and for a scheduler/worker-only process.
# privy   Privy access tokens only.
# both    Both, config first. REQUIRED wherever the api or mcp process runs
#         (SERVICE_TYPE=all included): the OAuth routes and the consent API
#         refuse to boot with any other value.
# Both sources fail closed and neither can admit a token the other refuses.
AUTH_SESSION_SOURCE=both

# Required as soon as AUTH_SESSION_SOURCE includes privy. Verification is LOCAL
# against the app's JWKS — PRIVY_APP_SECRET is used for one thing only, reading
# which wallets an identity has linked, and never to check a token.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# CAIP-2. The chain a Privy-authenticated agent's money settles on. No default
# on purpose: an inherited guess here is the difference between a devnet
# balance and a mainnet one. Devnet is
# solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1.
PRIVY_DEFAULT_CHAIN_ID=

# Optional. Defaults shown.
# PRIVY_API_BASE_URL=https://auth.privy.io
# PRIVY_ISSUER=privy.io
# PRIVY_JWKS_URL=                        derived from the app id when unset
# PRIVY_JWKS_TTL_MS=600000               how long a fetched key set is fresh
# PRIVY_JWKS_STALE_GRACE_MS=3600000      how long it may still be used when a
#                                        refresh FAILS. Past this, with nothing
#                                        cached, every token is refused — the
#                                        fail-closed branch.
# PRIVY_JWKS_MIN_REFRESH_MS=60000        floor between refreshes forced by an
#                                        unknown kid, so forged tokens cannot
#                                        amplify requests at Privy
# PRIVY_CLOCK_SKEW_MS=60000
# PRIVY_USER_LOOKUP_ENABLED=true         set false where no app secret exists;
#                                        agents then authenticate with no
#                                        linked wallet (AUTH_WALLET_NOT_LINKED)

# --- Operator access -------------------------------------------------------
# Operators sign in to the console with an EVM wallet: the console asks
# POST /api/v1/operator/auth/challenge for an EIP-4361 (Sign-In with Ethereum)
# message, the wallet signs it (personal_sign), and POST /operator/auth/verify
# returns a session token, sent as `Authorization: Bearer …`. There is no
# credentials file and no long-lived operator secret.
#
# The wallet must be an ACTIVE row in `operators`. The first ones are added
# with the CLI, which needs only database access:
#
#   yarn operator:add --wallet 0x… --subject dan@ --roles OPS_ADMIN,ADJL [--limit 0|<minor>|unbounded]
#   yarn operator:list
#   yarn operator:remove --wallet 0x…
#
# After that, OPS_ADMIN operators manage the directory in the console.
#
# Required. The console's host (RFC 3986 authority, e.g. console.goassay.ai or
# localhost:3000) and its sign-in URL. Every sign-in message names them and
# the backend refuses one naming anything else; unset refuses every sign-in.
OPERATOR_SIGN_IN_DOMAIN=
OPERATOR_SIGN_IN_URI=
# The EIP-155 chain id named in the message (nothing is sent to it).
# OPERATOR_SIGN_IN_CHAIN_ID=46630
# Session lifetime, whole hours, 1–24.
# OPERATOR_SESSION_TTL_HOURS=8
#
# Failed sign-ins and refused session tokens are counted per client address,
# and failed sign-ins also per wallet: after 10 within 5 minutes the key gets
# HTTP 429 (`OPERATOR_AUTH_RATE_LIMITED`) until the window ends and one
# error-level line is logged. Sign-in challenges are limited to 30 per client
# address per 5 minutes. The counts are skipped while Redis is down.

# --- Slash timing ----------------------------------------------------------
# Whole hours. `loadSlashConfig` reads it with `parsed > 0 ? parsed :
# fallback`, so **0 silently yields the default**, not zero — and nothing logs
# it. That `> 0` guard is a safety rail: a zero timelock would let a penalty
# execute in the same slot it was proposed.
#
# The timelock is also enforced by a CHECK constraint against
# `earliest_execution_at`, which is STAMPED ON THE ROW when the proposal is
# created — so changing it affects new proposals only. The provider disputes on
# chain until the record's own executableAt; no off-chain window runs.
SLASH_TIMELOCK_HOURS=                    # default 72

# ── Deposit finality watcher ─────────────────────────────────────────────────
# CAIP-2 chain whose vault token account is watched, so a deposit credits the
# moment it finalizes instead of on the next five-minute tick. UNSET = off, and
# off is the old behaviour: the sweep still credits every deposit.
DEPOSIT_WATCH_CHAIN_ID=
# Optional. Defaults to SOLANA_RPC_URL with http(s) swapped for ws(s).
SOLANA_RPC_WS_URL=

# EVM: blocks on top of a deposit before it is credited, or `finalized` for the
# chain's finalized head. Unset = 0 (the sequencer's soft confirmation). Any
# other value refuses to boot.
# EVM_DEPOSIT_CONFIRMATIONS=0

# ===========================================
# Public live demo
# ===========================================
# The credential the public /demo page calls as. Mint it with
# `yarn demo:identity` — it prints the token once and stores only its digest.
#
# Unset means the demo endpoints are not registered and /demo says it is not
# configured on this deployment.
#
# The credential lives in the DATABASE, so AUTH_SESSION_SOURCE must include
# `db` (that is `db` or `both`). On a `config`-only deployment the composite
# session source never reaches it and every demo call fails to resolve.
#
# The demo agent's SPEND POLICY is the budget — there is no separate counter.
# The documented defaults apply unless a policy row is written: perCallLimit
# $0.50, dailyLimit $10. At $0.02 a call that is 500 demo calls a day, and the
# refusal when it runs out is the ordinary spend-policy refusal a real agent
# would get.
#
# Funding it is a real deposit. `yarn demo:identity` deliberately does not
# invent a balance: a ledger credit with no vault money behind it is exactly
# what the proof-of-reserves page reports as a shortfall.
DEMO_MCP_TOKEN=
DEMO_ORGANIZATION_ID=

# The ONE executed slash the demo's compensation strip shows.
# Not the call the visitor just ran: a slash needs a violated SLA window, a
# signed attestation and a 72-hour timelock, and a visitor has no account to
# credit. Unset means the strip does not render — not an empty strip, and not
# $0.00. Silence asserts nothing; an empty block asserts zero.
DEMO_SLASH_PROPOSAL_ID=

# ===========================================
# Optional settings (all commented out; the code defaults apply when unset)
# ===========================================
# Outbound-HTTP guard that wraps Node's http/https primitives. Unset means
# installed outside production and not installed when NODE_ENV=production; an
# explicit true/false wins everywhere. See src/shared/network/egress/.
# EGRESS_LOCKDOWN=true

# Egress relay (workers/egress-relay/). When set, provider calls (bindings and
# connectivity checks) leave through this Cloudflare Worker, so providers never
# see this server's IP; the backend still resolves and checks every hop first.
# Unset means provider calls go direct (production logs a warning). With it set,
# a relay failure is a platform fault and never falls back to a direct call.
# EGRESS_RELAY_URL=https://egress.example.com
# Bearer secret shared with the Worker's RELAY_TOKEN: at least 32 random bytes,
# hex (openssl rand -hex 32). Read once at boot and removed from process.env.
# EGRESS_RELAY_TOKEN=

# Assay's own domains, comma-separated: each one and every subdomain is refused
# as an outbound target (provider endpoints, client metadata URLs, every
# redirect hop), so nothing third-party-chosen can make this server or the
# relay call back into our own origin. Keep equal to the Worker's
# DENIED_HOST_SUFFIXES. Default: goassay.ai.
# EGRESS_DENIED_HOST_SUFFIXES=goassay.ai

# Name servers for the outbound lookup, instead of the system resolver:
# comma-separated IP addresses, each with an optional :port (no host names).
# The answers get the same address check as before. With it set, /etc/hosts
# and search domains are not used (localhost keeps the system lookup), so a
# Docker service name only resolves if these servers know it. Default: unset.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Set to false to run a process without the cron scheduler. Default: enabled.
# SCHEDULER_ENABLED=true

# How long the operator dashboard's metrics collector caches its database-backed
# figures, in milliseconds. Default 30000.
# OBSERVABILITY_METRICS_CACHE_TTL_MS=30000

# Alert sinks. Each is off unless its *_ENABLED flag is exactly "true", and a
# sink that is enabled requires its URL / token and chat id.
# ALERT_WEBHOOK_ENABLED=false
# ALERT_WEBHOOK_URL=
# Per-severity overrides; each falls back to ALERT_WEBHOOK_URL.
# ALERT_WEBHOOK_URL_CRITICAL=
# ALERT_WEBHOOK_URL_WARN=
# Lowest severity the webhook delivers (INFO | WARN | CRITICAL). Default WARN.
# ALERT_WEBHOOK_MIN_SEVERITY=WARN
# Webhook request timeout in milliseconds. Default 5000.
# ALERT_WEBHOOK_TIMEOUT_MS=5000
# ALERT_TELEGRAM_ENABLED=false
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# Lowest severity Telegram delivers. Default WARN.
# ALERT_TELEGRAM_MIN_SEVERITY=WARN
# Optional forum-topic id for Telegram supergroups.
# ALERT_TELEGRAM_MESSAGE_THREAD_ID=

# Kora (kora/kora.toml) allows only the default devnet USDC mint. If you
# override SOLANA_DEVNET_USDC_MINT above, add that mint to `allowed_tokens` in
# kora/kora.toml as well, or Kora refuses to sign for it.

# ===========================================
# Provider credential vault
# ===========================================
# Key-encryption keys for the credential headers providers attach to their
# bindings. A JSON array of { keyId, key } where key is 32 bytes as 64 hex
# characters; the FIRST entry encrypts new sets, the rest only decrypt older
# ones (list the outgoing key during a rotation). Generate a key with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#   CREDENTIAL_VAULT_KEKS=[{"keyId":"kek-2026-10","key":"<64 hex chars>"}]
#
# Needed by the api and mcp processes only. With NODE_ENV=production, unset
# FAILS THE BOOT. Outside production, unset means credentials cannot be stored
# (503) and existing ones cannot be read. READ ONCE AT BOOT AND DELETED FROM
# process.env, like VERIFIER_SIGNING_KEYS.
CREDENTIAL_VAULT_KEKS=

# Ed25519 keys that sign outbound requests to provider endpoints (RFC 9421 style).
# JSON array, first entry is active, same format as VERIFIER_SIGNING_KEYS:
#   PROVIDER_REQUEST_SIGNING_KEYS=[{"keyId":"req-2026-10","secretKey":"<64 hex chars>"}]
# Use a key DIFFERENT from the verifier's. Generate one with
# scripts/verifier-key/generate.ts. Public keys are served at
# /.well-known/assay-request-keys.json. Needed by the api and mcp processes only;
# with NODE_ENV=production, unset fails their boot. READ ONCE AT BOOT AND DELETED
# FROM process.env.
PROVIDER_REQUEST_SIGNING_KEYS=

# Buyer call disputes (G3.B1). See docs/runbooks/call-dispute-hold.md.
# The CAIP-2 chains whose AssayEscrow has "redeem into hold" — set IN THE SAME
# DEPLOY as the upgrade (the backend also detects the hold from the escrow). On a live chain a redemption whose receipt shows no
# hold is retried, never paid at once; refunds are guaranteed only there.
EVM_HOLD_LIVE_CHAINS=
# Dispute hold. Rail B: on chain, AssayConfig.collectHoldSeconds (redeem into
# hold). Rail A: the provider's ledger credit is withheld this many minutes
# (1-1440). A malformed value refuses to boot.
CALL_DISPUTE_HOLD_WINDOW_MINUTES=60
CALL_DISPUTE_FILING_WINDOW_DAYS=7
CALL_DISPUTE_MAX_PER_DAY=20
CALL_DISPUTE_ABUSE_MAX_PER_DAY=2
CALL_DISPUTE_ABUSE_REJECTED_THRESHOLD=5
# Whole units of the call's asset (decimals are applied), e.g. 5 or 2.5.
CALL_DISPUTE_TWO_PERSON_THRESHOLD=5
# Filings per (buyer organization, provider) per day, and auto-upholds per
# provider per day (past it the SLA pages an operator instead).
CALL_DISPUTE_MAX_PER_PROVIDER_PER_DAY=10
CALL_DISPUTE_MAX_AUTO_UPHOLDS_PER_PROVIDER_PER_DAY=20
CALL_DISPUTE_SNAPSHOT_RETENTION_DAYS=30

# --- OAuth authorization server (MCP host) and consent API -----------------
# Read by every process that mounts the OAuth routes or the OAuth session
# source; each check below refuses to boot. AUTH_SESSION_SOURCE must be "both"
# there (the consent API needs the Privy source), and MCP_PUBLIC_URL and
# WEB_APP_URL must be https in production. MCP_PUBLIC_URL is the issuer and
# the access-token audience.
#
# Key for the pending-request browser cookie: at least 32 random bytes, hex;
# a low-entropy value is refused. Required on the mcp process (and so under
# SERVICE_TYPE=all); the placeholder below is refused until you replace it.
# Generate one with: openssl rand -hex 32
# Read once at boot and removed from process.env.
OAUTH_REQUEST_COOKIE_SECRET=replace-with-output-of-openssl-rand-hex-32
#
# Exact redirect URIs (besides loopback) a browser may be sent back to: canonical
# https URIs or private-use schemes (reverse-domain such as
# com.example.app:/cb, or cursor: / vscode:) with a path. No wildcard, query,
# fragment or duplicate.
# Entries with "review": true are listed but refused until confirmed. Unset
# means the built-in list (ChatGPT cleared; claude.ai, claude.com, vscode.dev
# and Cursor under review). Setting it replaces that list.
# OAUTH_REDIRECT_ALLOWLIST=[{"uri":"https://chatgpt.com/connector_platform_oauth_redirect","review":false}]
#
# Clients shown as "Verified" when they return to one of their vendor
# redirects. Every vendorRedirects entry must be an https allowlist entry with
# "review": false. Empty by default.
# OAUTH_VERIFIED_CLIENTS=[{"clientId":"https://client.example.com/oauth/client.json","displayName":"Example","vendorRedirects":["https://chatgpt.com/connector_platform_oauth_redirect"]}]
#
# Client ids whose grants may bind a payment key and use the API host. Only the
# built-in client may be named (owner rule: hosted connectors and other apps
# never bind a key); any other id refuses to boot. Default:
# ["{MCP_PUBLIC_URL}/oauth/clients/assay-mcp"].
# OAUTH_PAYMENT_CLIENTS=["http://localhost:3200/oauth/clients/assay-mcp"]
#
# e2e only: accept http://localhost client metadata URLs. Refused when
# NODE_ENV=production. Default false.
# OAUTH_ALLOW_HTTP_CIMD_LOOPBACK=false
#
# Dynamic client registration limits. Defaults shown.
# OAUTH_DCR_GLOBAL_PER_DAY=1000
# OAUTH_DCR_PER_48_PER_HOUR=50
